# Copy to .env.local and fill in. All vars are optional —
# the site builds and runs without them, with placeholder ad slots and no analytics.

# Google AdSense — apply at https://adsense.google.com (post-deploy, after some traffic).
NEXT_PUBLIC_ADSENSE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
NEXT_PUBLIC_ADSENSE_SLOT_HEADER=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=1234567890
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER=1234567890

# Google Analytics 4 — create a property at https://analytics.google.com.
NEXT_PUBLIC_GA4_ID=G-XXXXXXXXXX
